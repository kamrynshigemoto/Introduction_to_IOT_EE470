#include <Arduino.h>
#include <ESP8266WiFi.h>
#include <ESP8266HTTPClient.h>
#include <WiFiClientSecure.h>

#define wifi_ssid "five potatoes"
#define wifi_password "shigeymomo31"
#define LEDstatusURL "https://kshigemotoee.com/results.txt"
#define RGBvalueURL "https://kshigemotoee.com/rgbslider.txt"
#define GoogleSheetsURL "https://script.google.com/macros/s/AKfycbxRl6rsKEawrugZrk7FkCqLpkXnCge2GaQ56qlUA450_kbIxIDCFCy1UBqOVttdoy79/exec"

unsigned long lastCheck = 0;    //stores the last time ESP checked for LED status
const unsigned long checkInterval = 150000; //2.5 minutes (150,000ms)

const int buttonpin = D5;   //using push button module
const int LEDpin = D6;    
const int redpin = D2;
const int greenpin = D3;
const int bluepin = D4;

String LEDstatus = "unknown";
int RGBintensity = 0;

void setup() {
  pinMode(LEDpin, OUTPUT);    //LED pin is output
  pinMode(buttonpin, INPUT_PULLUP);   //takes button as input, enable pullup resistor
  Serial.begin(9600);   //start serial communication
  pinMode(redpin, OUTPUT);    //red rgb output
  pinMode(greenpin, OUTPUT);  //green rgb output
  pinMode(bluepin, OUTPUT);   //blue rgb output

  //connect to wifi network (my hotspot)
  WiFi.begin(wifi_ssid, wifi_password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("WiFi Connected");
}

