//simultaneously check LED and RGB status
void checkLEDandRGB() {
  if (WiFi.status() == WL_CONNECTED) {
    WiFiClientSecure client;
    client.setInsecure();
    HTTPClient http;

    //check status of LED
    http.begin(client, LEDstatusURL);
    int httpCode = http.GET(); //send GET request to results.txt
    if (httpCode == 200) {
      LEDstatus = http.getString();
      LEDstatus.trim();   //get rid of extra whitespace/newline chars
      if (LEDstatus == "on") {
        digitalWrite(LEDpin, HIGH);
        Serial.println("LED ON");
      }
      else if (LEDstatus == "off") {
        digitalWrite(LEDpin, LOW);
        Serial.println("LED OFF");
      }
    } else {
      Serial.println("Error: GET request for LED failed, code: " + String(httpCode));
    }
    http.end();

    //check rgb value
    http.begin(client, RGBvalueURL);
    httpCode = http.GET();  //send GET request to rgbslider.txt
    if (httpCode == 200) {
      String RGBvalue = http.getString();
      RGBvalue.trim();    //get rid of extra whitespace/newline chars
      RGBintensity = RGBvalue.toInt(); //convert RGB value to int
      analogWrite(redpin, RGBintensity);
      analogWrite(greenpin, 0);
      analogWrite(bluepin, 0);
      Serial.println("RGB red intensity set to: " + String(RGBintensity));
    }
    else {
      Serial.println("Error: GET request for RGB failed, code: " + String(httpCode));
    }
    http.end();
  } else {
    Serial.println("Error: WiFi not connected");
  }
}

void sendtoGoogleSheets (int rgb, String led) {
  if (WiFi.status() == WL_CONNECTED) {
    WiFiClientSecure client;
    client.setInsecure();
    HTTPClient http;

    String url = String(GoogleSheetsURL) + "?rgb=" + String(rgb) + "&led=" + led;
    http.begin(client, url);
    int httpCode = http.GET();

    /*
    if (httpCode >= 200 && httpCode < 300) {
      Serial.println("Logged successfully in Google Sheets");
    }
    else {
      Serial.println("Error: Failed to log to Google Sheets, code: " + String(httpCode));
    }*/
    http.end();
  }
}

void loop() {
  //check every 2.5 minutes
  if (millis() - lastCheck > checkInterval) {
    checkLEDandRGB();   //if 2.5 minutes passed, read LED status
    lastCheck = millis();
  }

  // check if button pressed
  if (digitalRead(buttonpin) == LOW) {
    checkLEDandRGB();
    sendtoGoogleSheets(RGBintensity, LEDstatus);
    delay(500); //key debounce
  }
}
