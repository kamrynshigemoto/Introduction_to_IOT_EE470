#include <ESP8266WiFi.h>
#include <WiFiClientSecure.h>
#include <PubSubClient.h>

// ==== WiFi credentials ====
const char* ssid = "";
const char* password = "";

// ==== MQTT broker ====
const char* mqtt_server = "broker.mqttdashboard.com";
const int mqtt_port = 8883;
const char* client_id = "esp8266-808"; // make unique
const char* topic_out = "testtopic/temp/outTopic/8888"; //unique code = 8888
const char* topic_in = "testtopic/temp/inTopic/8888";

// ==== Pins ====
#define PIN_POT A0
#define PIN_BTN D5
#define LED_PIN LED_BUILTIN

WiFiClientSecure espClient;
PubSubClient client(espClient);

// button state tracking
int lastBtnState = LOW;
bool pendingZero = false;
unsigned long zeroDueTime = 0;

// time interval for publishing potentiometer results
unsigned long lastPublish = 0;
const unsigned long publishInterval = 60000; // 60 seconds

// callback for MQTT
void callback(char* topic, byte* payload, unsigned int length) {
  String msg;
  for (unsigned int i=0; i<length; i++) {
    msg += (char)payload[i];
  }


if (String(topic) == topic_in) {
  if (msg == "1") {
    digitalWrite(LED_PIN, LOW); //ON
    Serial.println("LED turned ON via MQTT");
  }
  else if (msg == "0") {
    digitalWrite(LED_PIN, HIGH); //OFF
    Serial.println("LED turned OFF via MQTT");
  }
}
}

void setup_wifi() {
  delay(10);
  Serial.println();
  Serial.print("Connecting to ");
  Serial.println(ssid);

  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("WiFi connected");
  Serial.print("IP address: ");
  Serial.println(WiFi.localIP());
}

void reconnect() {
  while (!client.connected()) {
    Serial.print("Attempting MQTT connection...");
    if (client.connect(client_id)) {
      Serial.println("connected");
      client.subscribe(topic_in);
      Serial.printf("Subscribed to %s\n", topic_in);
    } else {
      Serial.print("failed, rc=");
      Serial.print(client.state());
      Serial.println(" try again in 5 seconds");
      delay(5000);
    }
  }
}

float toVolts(int raw) {
  return (3.3f * raw) / 1023.0f;
}

void setup() {
  Serial.begin(9600);
  pinMode(PIN_BTN, INPUT);
  pinMode(LED_PIN, OUTPUT);
  digitalWrite(LED_PIN, HIGH); // LED off

  setup_wifi();

  espClient.setInsecure(); // skip certificate validation for demo
  client.setServer(mqtt_server, mqtt_port);
  client.setCallback(callback);
}

void loop() {
  if (!client.connected()) {
    reconnect();
  }
  client.loop();

  unsigned long now = millis();

  // 1) publish potentiometer every 60s
  if (now - lastPublish > publishInterval) {
    lastPublish = now;

    int potRaw = analogRead(PIN_POT);
    float volts = toVolts(potRaw);

    // Publish raw and volts as a string
    String payload = String(potRaw) + "," + String(volts, 2);
    client.publish(topic_out, payload.c_str());

    Serial.printf("Published to %s: %s\n", topic_out, payload.c_str());
  }

  // 2) Button press/release logic
  int btnState = digitalRead(PIN_BTN);  //HIGH when pressed
  if (btnState == HIGH && lastBtnState == LOW) {
    // button released event
    client.publish(topic_out, "1");
    Serial.println("Button released --> publish 1");
    pendingZero = true;
    zeroDueTime = now + 5000; // schedule 0 after 5s
  }
  lastBtnState = btnState;

  // send 0 after 5s
  if (pendingZero && now >= zeroDueTime) {
    client.publish(topic_out, "0");
    Serial.println("Publish 0 (5s after release)");
    pendingZero = false;
  }
}

